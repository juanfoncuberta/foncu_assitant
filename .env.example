# Lo consigues hablando con @BotFather en Telegram (comando /newbot)
TELEGRAM_BOT_TOKEN=tu_token_de_botfather

# Lo consigues en console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=tu_api_key_de_anthropic

# Lo consigues en todoist.com -> Configuración -> Integraciones -> Token de API
TODOIST_API_TOKEN=tu_token_de_todoist


# Proveedor de tareas activo. Cambia este valor para usar otro backend sin tocar el código.
# Opciones disponibles: todoist
TASK_PROVIDER=task_provider

# Lo consigues en cloud.digitalocean.com -> API -> Tokens -> Generate New Token (read-only basta)
DIGITALOCEAN_TOKEN=tu_token_de_digitalocean

# Tu chat_id de Telegram (úsalo para recibir avisos proactivos del bot)
OWNER_CHAT_ID=232881733