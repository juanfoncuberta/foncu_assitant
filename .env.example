# Lo consigues hablando con @BotFather en Telegram (comando /newbot)
TELEGRAM_BOT_TOKEN=tu_token_de_botfather

# Lo consigues en console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=tu_api_key_de_anthropic

# Lo consigues en todoist.com -> Configuración -> Integraciones -> Token de API
TODOIST_API_TOKEN=tu_token_de_todoist


# Proveedor de tareas activo. Cambia este valor para usar otro backend sin tocar el código.
# Opciones disponibles: todoist
TASK_PROVIDER=todoist

# Lo consigues en cloud.digitalocean.com -> API -> Tokens -> Generate New Token (read-only basta)
DIGITALOCEAN_TOKEN=tu_token_de_digitalocean

# Tu chat_id de Telegram (para los avisos proactivos del bot).
# Es un entero pelado, NO el token: escríbele al bot y míralo en
#   https://api.telegram.org/bot<TOKEN>/getUpdates  ->  result[].message.chat.id
OWNER_CHAT_ID=123456789

# API key para autenticar llamadas a internal_api.py (n8n, futuros agentes).
# Genera una propia con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=tu_api_key_interna

# Raíces bajo las que se permite vincular carpetas de proyecto con
# vincular_carpeta_proyecto. Separadas por comas. Limita dónde puede acabar
# ejecutándose Claude Code, así que mantenla lo más estrecha posible.
ALLOWED_PROJECT_ROOTS=/opt

# Revisión posterior del diff por el subagent `reviewer` tras cada tarea de dev.
# Cuesta una llamada extra a claude -p por tarea; ponlo a false para desactivarla.
REVIEWER_ENABLED=true

# Chats de Telegram autorizados a hablar con el bot, separados por comas.
# Si se deja vacio, solo se autoriza OWNER_CHAT_ID. Cualquier otro chat es
# ignorado en silencio. Los bots de Telegram son publicos: sin esto, quien de
# con el @username tiene acceso completo a Todoist y al droplet.
ALLOWED_CHAT_IDS=

# Modelo de Claude Code por paso. Vacio = el que tenga configurado la CLI.
# Los pasos de plan y revision son de solo lectura: normalmente no necesitan el
# modelo mas caro. Mide el ahorro con usage_log antes de fijarlos.
PLAN_MODEL=
EXEC_MODEL=
REVIEW_MODEL=

# Canal de aviso independiente de Telegram, para cuando lo que falla ES Telegram
# (OWNER_CHAT_ID mal, bot bloqueado). Cualquier URL que acepte POST con JSON:
# el webhook de n8n del droplet, Slack, Discord... Vacio = solo queda el log.
ALERT_WEBHOOK_URL=
